# --- Core -------------------------------------------------------------
WAYFARE_RUNTIME=selfhost            # selfhost | firebase
WAYFARE_BASE_URL=http://localhost:3000
WAYFARE_SECRET=change-me-to-a-long-random-string-of-32+-chars
WAYFARE_ADMIN_EMAILS=you@example.com
WAYFARE_DEMO_MODE=false
WAYFARE_TRUSTED_PROXIES=1          # reverse proxies appending to X-Forwarded-For (0 = none)
DATA_DIR=./data
# STORAGE_DRIVER=local              # local | s3 | firebase (default depends on runtime)

# --- Mail (magic links, notifications). Empty = log to console ------
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Wayfare <no-reply@example.com>"

# --- Login providers (enabled when ID + secret are set) -------------
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=
# AUTH_APPLE_BUNDLE_ID=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=
# AUTH_DISCORD_ID=
# AUTH_DISCORD_SECRET=
AUTH_PASSKEY=true
AUTH_MAGIC_LINK=true
AUTH_EMAIL_PASSWORD=false

# --- Photo sources (Google Photos / Drive) --------------------------
# GOOGLE_SOURCES_CLIENT_ID=         # defaults to AUTH_GOOGLE_ID
# GOOGLE_SOURCES_CLIENT_SECRET=
# GOOGLE_API_KEY=                   # Drive Picker
# GOOGLE_APP_ID=                    # Cloud project number (Drive Picker)

# --- S3 (STORAGE_DRIVER=s3) -----------------------------------------
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Firebase (WAYFARE_RUNTIME=firebase) ----------------------------
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_SERVICE_ACCOUNT=         # JSON; omit to use Application Default Credentials

# --- Cron (daily digest: POST /api/cron/digest with Bearer token) ---
# CRON_SECRET=
