rules_version = '2';

// Photos are written and read only by the Wayfare server (Admin SDK bypasses these rules)
// and delivered through signed, short-lived /api/media URLs after access checks.
// Therefore: deny ALL direct client access, never expose bucket URLs.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
